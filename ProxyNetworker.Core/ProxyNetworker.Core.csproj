<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	  <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Native.Quic.MsQuic.OpenSSL" Version="2.6.3" />
    <PackageReference Include="Microsoft.Native.Quic.MsQuic.Schannel" Version="2.6.3" />
    <PackageReference Include="StirlingLabs.MsQuic.Bindings.runtime.linux-x64.openssl" Version="2.2.2" />
    <PackageReference Include="Vanara.PInvoke.IpHlpApi" Version="5.0.5" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ProxyNetworker.Core.Tests" />
  </ItemGroup>

  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'linux-x64'">
    <None Include="$(NuGetPackageRoot)stirlinglabs.msquic.bindings.runtime.linux-x64.openssl/2.2.2/runtimes/linux-x64/native/libmsquic-openssl.so"
          Link="libmsquic.so.2"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Platforms\Windows\Wintun\DLL\win-x64\wintun.dll" Pack="true" PackagePath="runtimes/win-x64/native" />
    <None Include="Platforms\Windows\Wintun\DLL\win-x86\wintun.dll" Pack="true" PackagePath="runtimes/win-x86/native" />
    <None Include="Platforms\Windows\Wintun\DLL\win-arm\wintun.dll" Pack="true" PackagePath="runtimes/win-arm/native" />
    <None Include="Platforms\Windows\Wintun\DLL\win-arm64\wintun.dll" Pack="true" PackagePath="runtimes/win-arm64/native" />
  </ItemGroup>

</Project>
