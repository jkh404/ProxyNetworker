<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	  <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="Microsoft.Native.Quic.MsQuic.OpenSSL" Version="2.6.3" />
    <PackageReference Include="Microsoft.Native.Quic.MsQuic.Schannel" Version="2.6.3" />
    <PackageReference Include="StirlingLabs.MsQuic.Bindings.runtime.linux-x64.openssl" Version="2.2.2" />
    <PackageReference Include="Vanara.PInvoke.IpHlpApi" Version="5.0.5" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ProxyNetworker.Core.Tests" />
    <InternalsVisibleTo Include="ProxyNetworker.Client" />
    <InternalsVisibleTo Include="ProxyNetworker.Client.Runtime" />
  </ItemGroup>

  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <MacOsUtunShimPath>$(BaseIntermediateOutputPath)$(Configuration)/$(TargetFramework)/$(RuntimeIdentifier)/native/libproxynetworker-utun.dylib</MacOsUtunShimPath>
    <MacOsUtunArchitecture Condition="'$(RuntimeIdentifier)' == 'osx-arm64'">-arch arm64</MacOsUtunArchitecture>
    <MacOsUtunArchitecture Condition="'$(RuntimeIdentifier)' == 'osx-x64'">-arch x86_64</MacOsUtunArchitecture>
  </PropertyGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <None Include="$(MacOsUtunShimPath)" Link="libproxynetworker-utun.dylib"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="BuildMacOsUtunShim" BeforeTargets="CoreCompile"
          Condition="$([MSBuild]::IsOSPlatform('OSX')) And '$(TargetFramework)' != ''"
          Inputs="$(MSBuildProjectDirectory)/Platforms/MacOS/native/utun_shim.c"
          Outputs="$(MacOsUtunShimPath)">
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(MacOsUtunShimPath)'))" />
    <Exec Command="xcrun clang -std=c11 -dynamiclib -fvisibility=hidden -Wall -Wextra -Werror -O2 -mmacosx-version-min=14.0 $(MacOsUtunArchitecture) &quot;$(MSBuildProjectDirectory)/Platforms/MacOS/native/utun_shim.c&quot; -Wl,-install_name,@rpath/libproxynetworker-utun.dylib -o &quot;$(MacOsUtunShimPath)&quot;" />
  </Target>

  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'linux-x64'">
    <None Include="$(NuGetPackageRoot)stirlinglabs.msquic.bindings.runtime.linux-x64.openssl/2.2.2/runtimes/linux-x64/native/libmsquic-openssl.so"
          Link="libmsquic.so.2"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Platforms\Windows\Wintun\DLL\win-x64\wintun.dll" Pack="true" PackagePath="runtimes/win-x64/native" />
    <None Include="Platforms\Windows\Wintun\DLL\win-x86\wintun.dll" Pack="true" PackagePath="runtimes/win-x86/native" />
    <None Include="Platforms\Windows\Wintun\DLL\win-arm\wintun.dll" Pack="true" PackagePath="runtimes/win-arm/native" />
    <None Include="Platforms\Windows\Wintun\DLL\win-arm64\wintun.dll" Pack="true" PackagePath="runtimes/win-arm64/native" />
  </ItemGroup>

</Project>
