{
  "ProxyNetworkerClient": {
    "apiServer": "http://127.0.0.1:13301",
    "portTunnels": [
      {
        "enabled": false,
        "name": "web",
        "token": "ptun_replace_this_token"
      }
    ],
    "virtualNetwork": {
      "enabled": true,
      "name": "pn-client",
      "token": "vnet_replace_this_token"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  }
}
