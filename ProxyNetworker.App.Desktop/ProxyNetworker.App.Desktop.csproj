<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ProxyNetworker.App.Tests" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="TKCode.Spyglass.Agent" Version="0.1.3" Condition="'$(Configuration)' == 'Debug'" />
    <ProjectReference Include="../ProxyNetworker.App/ProxyNetworker.App.csproj" />
    <ProjectReference Include="../ProxyNetworker.Worker/ProxyNetworker.Worker.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="StageNetworkWorker" AfterTargets="Build">
    <ItemGroup>
      <WorkerFiles Include="../ProxyNetworker.Worker/bin/$(Configuration)/net10.0/**/*"
                   Exclude="../ProxyNetworker.Worker/bin/$(Configuration)/net10.0/**/*.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(WorkerFiles)" DestinationFiles="@(WorkerFiles->'$(OutDir)worker/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishNetworkWorker" AfterTargets="Publish">
    <MSBuild Projects="../ProxyNetworker.Worker/ProxyNetworker.Worker.csproj" Targets="Publish"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=true;PublishDir=$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(PublishDir)', 'worker'))/;PublishAot=false" />
  </Target>
</Project>
